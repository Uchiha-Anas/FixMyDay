# FixMyDay configuration. Copy to .env.local and fill in what you need.
# With nothing set, the app runs in DEMO MODE: no accounts, data stored in the
# browser's localStorage, brain dumps parsed by the built-in demo parser.

# --- Supabase (enables accounts + cloud storage) -----------------------------
# Project Settings → API in the Supabase dashboard. Both values are public by
# design; Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
# Either the new publishable key or the legacy anon key:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- AI provider (server-side only; never prefix with NEXT_PUBLIC_) ----------
# Optional. Picks "anthropic" if ANTHROPIC_API_KEY is set, else "openai".
# AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Without Supabase there is no login, so AI calls are anonymous. They are allowed
# in development; in production they're disabled unless you opt in here.
# AI_ALLOW_ANONYMOUS=false
